#!/usr/bin/env node
"use strict";

/*
 * Explicit sync CLI for the dot-agents personal agent environment.
 *
 * Repository content is canonical. Harness runtime directories receive
 * materialized copies only when `dot-agents sync` is invoked. `dot-agents
 * check` is read-only.
 */

const fs = require("node:fs");
const path = require("node:path");
const os = require("node:os");
const crypto = require("node:crypto");
const { spawnSync } = require("node:child_process");

class RuntimeError extends Error {}

const HARNESS_NAMES = ["codex", "claude", "antigravity"];
const HARNESS_LABELS = {
  codex: "Codex",
  claude: "Claude Code",
  antigravity: "Google Antigravity",
};
const SKILL_RUNTIME_REQUIREMENTS = [
  { runtime: "cmux", executable: "cmux", matches: (name) => name === "cmux" || name.startsWith("cmux-") },
  { runtime: "herdr", executable: "herdr", matches: (name) => name === "herdr" || name.startsWith("herdr-") },
];

class Action {
  constructor(kind, destination, label, options = {}) {
    this.kind = kind;
    this.destination = destination;
    this.label = label;
    this.source = options.source ?? null;
    this.content = options.content ?? null;
    this.jsonValue = options.jsonValue ?? null;
  }
}

function expandPath(value) {
  const raw = String(value);
  if (raw === "~") return os.homedir();
  if (raw.startsWith("~/")) return path.join(os.homedir(), raw.slice(2));
  return raw;
}

function absolutePath(value) {
  return path.resolve(expandPath(value));
}

function installHome() {
  return absolutePath(process.env.DOT_AGENTS_SETUP_HOME || os.homedir());
}

function configHome(home) {
  if (process.env.DOT_AGENTS_CONFIG_HOME) return absolutePath(process.env.DOT_AGENTS_CONFIG_HOME);
  if (process.env.XDG_CONFIG_HOME && !process.env.DOT_AGENTS_SETUP_HOME) {
    return path.resolve(expandPath(process.env.XDG_CONFIG_HOME), "dot-agents");
  }
  return path.join(home, ".config", "dot-agents");
}

function pathExists(file) {
  try {
    fs.lstatSync(file);
    return true;
  } catch (error) {
    if (error.code === "ENOENT") return false;
    throw error;
  }
}

function isFile(file) {
  try {
    return fs.lstatSync(file).isFile();
  } catch (error) {
    if (error.code === "ENOENT") return false;
    throw error;
  }
}

function isDirectory(file) {
  try {
    return fs.lstatSync(file).isDirectory();
  } catch (error) {
    if (error.code === "ENOENT") return false;
    throw error;
  }
}

function isSymlink(file) {
  try {
    return fs.lstatSync(file).isSymbolicLink();
  } catch (error) {
    if (error.code === "ENOENT") return false;
    throw error;
  }
}

function looksLikeRepo(repo) {
  return (
    isFile(path.join(repo, "preferences", "communication.md")) &&
    isFile(path.join(repo, "preferences", "engineering.md")) &&
    isDirectory(path.join(repo, "harnesses")) &&
    isDirectory(path.join(repo, "skills")) &&
    isFile(path.join(repo, "scripts", "dot-agents"))
  );
}

function resolveRepo(home, cfg) {
  if (process.env.DOT_AGENTS_REPO) {
    const candidate = absolutePath(process.env.DOT_AGENTS_REPO);
    if (!looksLikeRepo(candidate)) throw new RuntimeError(`DOT_AGENTS_REPO is not a dot-agents repository: ${candidate}`);
    return candidate;
  }
  const scriptRepo = path.resolve(__dirname, "..");
  if (looksLikeRepo(scriptRepo)) return scriptRepo;
  const pointer = path.join(cfg, "repo");
  if (isFile(pointer)) {
    const raw = readText(pointer).trim();
    if (raw) {
      const candidate = absolutePath(raw);
      if (looksLikeRepo(candidate)) return candidate;
      throw new RuntimeError(`configured dot-agents repository is invalid: ${candidate}`);
    }
  }
  throw new RuntimeError("dot-agents repository is not configured; run ./scripts/dot-agents sync from the cloned repository");
}

function readText(file) {
  return fs.readFileSync(file, "utf8");
}

function normalizeHarnesses(values) {
  if (!Array.isArray(values)) throw new RuntimeError("harness selection must be an array");
  const selected = new Set();
  for (const value of values) {
    if (typeof value !== "string" || !value.trim()) throw new RuntimeError("harness names must be non-empty strings");
    const name = value.trim().toLowerCase();
    if (!HARNESS_NAMES.includes(name)) throw new RuntimeError(`unknown harness: ${value}; expected ${HARNESS_NAMES.join(", ")}`);
    selected.add(name);
  }
  return HARNESS_NAMES.filter((name) => selected.has(name));
}

function harnessSelectionPath(cfg) {
  return path.join(cfg, "harnesses.json");
}

function readHarnessSelection(cfg) {
  const file = harnessSelectionPath(cfg);
  if (!pathExists(file)) return null;
  const value = loadJsonObject(file);
  if (value.version !== 1) throw new RuntimeError(`unsupported harness selection version in ${file}`);
  return normalizeHarnesses(value.harnesses);
}

function harnessSelectionBytes(harnesses) {
  return jsonBytes({ version: 1, harnesses: normalizeHarnesses(harnesses) });
}

function contentBuffer(value) {
  return Buffer.isBuffer(value) ? value : Buffer.from(value, "utf8");
}

function generatedCodex(repo) {
  return [
    "<!-- Generated from dot-agents. Do not edit directly. -->\n\n",
    readText(path.join(repo, "preferences", "communication.md")).replace(/\n+$/, "") + "\n\n",
    readText(path.join(repo, "preferences", "engineering.md")).replace(/\n+$/, "") + "\n\n",
    readText(path.join(repo, "harnesses", "codex", "AGENTS.md")).replace(/\n+$/, "") + "\n",
  ].join("");
}

function generatedClaude(repo) {
  const source = readText(path.join(repo, "harnesses", "claude", "CLAUDE.md"));
  const lines = ["<!-- Generated from dot-agents. Do not edit directly. -->", ""];
  const prefix = "@../../preferences/";
  for (const line of source.split(/\r?\n/)) {
    if (line.startsWith(prefix)) lines.push(`@${repo}/preferences/${line.slice(prefix.length)}`);
    else lines.push(line);
  }
  return lines.join("\n").replace(/\n+$/, "") + "\n";
}

function generatedAntigravity(repo) {
  return [
    "<!-- Generated from dot-agents. Do not edit directly. -->\n\n",
    readText(path.join(repo, "preferences", "communication.md")).replace(/\n+$/, "") + "\n\n",
    readText(path.join(repo, "preferences", "engineering.md")).replace(/\n+$/, "") + "\n\n",
    readText(path.join(repo, "harnesses", "antigravity", "instructions.md")).replace(/\n+$/, "") + "\n",
  ].join("");
}

function launcherContent() {
  return `#!/bin/sh
set -eu
CONFIG_HOME=\${DOT_AGENTS_CONFIG_HOME:-\${XDG_CONFIG_HOME:-\$HOME/.config}/dot-agents}
REPO_FILE="$CONFIG_HOME/repo"
if [ ! -f "$REPO_FILE" ]; then
  echo "dot-agents: repository is not configured; run ./scripts/dot-agents sync from the cloned repository" >&2
  exit 2
fi
REPO=\$(cat "$REPO_FILE")
exec "$REPO/scripts/dot-agents" "$@"
`;
}

function loadJsonObject(file, allowMissing = false) {
  if (allowMissing && !pathExists(file)) return {};
  let value;
  try {
    value = JSON.parse(readText(file));
  } catch (error) {
    if (error.code === "ENOENT") throw new RuntimeError(`missing JSON file: ${file}`);
    if (error instanceof SyntaxError) throw new RuntimeError(`invalid JSON in ${file}: ${error.message}`);
    throw error;
  }
  if (value === null || Array.isArray(value) || typeof value !== "object") throw new RuntimeError(`expected a JSON object in ${file}`);
  return value;
}

function isPlainObject(value) {
  return value !== null && typeof value === "object" && !Array.isArray(value);
}

function deepMerge(base, overlay) {
  const result = { ...base };
  for (const [key, value] of Object.entries(overlay)) {
    if (isPlainObject(value) && isPlainObject(result[key])) result[key] = deepMerge(result[key], value);
    else result[key] = value;
  }
  return result;
}

function deepEqual(left, right) {
  if (Object.is(left, right)) return true;
  if (Array.isArray(left) || Array.isArray(right)) {
    return Array.isArray(left) && Array.isArray(right) && left.length === right.length && left.every((item, index) => deepEqual(item, right[index]));
  }
  if (isPlainObject(left) || isPlainObject(right)) {
    if (!isPlainObject(left) || !isPlainObject(right)) return false;
    const leftKeys = Object.keys(left);
    const rightKeys = Object.keys(right);
    return leftKeys.length === rightKeys.length && leftKeys.every((key) => Object.prototype.hasOwnProperty.call(right, key) && deepEqual(left[key], right[key]));
  }
  return false;
}

function stripTomlComment(line) {
  let quote = null;
  let escaped = false;
  let depth = 0;
  for (let index = 0; index < line.length; index += 1) {
    const char = line[index];
    if (quote === '"') {
      if (escaped) escaped = false;
      else if (char === "\\") escaped = true;
      else if (char === '"') quote = null;
      continue;
    }
    if (quote === "'") {
      if (char === "'") quote = null;
      continue;
    }
    if (char === '"' || char === "'") quote = char;
    else if (char === "[" || char === "{") depth += 1;
    else if (char === "]" || char === "}") depth = Math.max(0, depth - 1);
    else if (char === "#" && depth === 0) return line.slice(0, index);
  }
  return line;
}

function topLevelIndex(text, wanted) {
  let quote = null;
  let escaped = false;
  let depth = 0;
  for (let index = 0; index < text.length; index += 1) {
    const char = text[index];
    if (quote === '"') {
      if (escaped) escaped = false;
      else if (char === "\\") escaped = true;
      else if (char === '"') quote = null;
      continue;
    }
    if (quote === "'") {
      if (char === "'") quote = null;
      continue;
    }
    if (char === '"' || char === "'") quote = char;
    else if (char === "[" || char === "{") depth += 1;
    else if (char === "]" || char === "}") depth -= 1;
    else if (char === wanted && depth === 0) return index;
  }
  return -1;
}

function splitTopLevel(text, delimiter) {
  const parts = [];
  let start = 0;
  let quote = null;
  let escaped = false;
  let depth = 0;
  for (let index = 0; index < text.length; index += 1) {
    const char = text[index];
    if (quote === '"') {
      if (escaped) escaped = false;
      else if (char === "\\") escaped = true;
      else if (char === '"') quote = null;
      continue;
    }
    if (quote === "'") {
      if (char === "'") quote = null;
      continue;
    }
    if (char === '"' || char === "'") quote = char;
    else if (char === "[" || char === "{") depth += 1;
    else if (char === "]" || char === "}") depth -= 1;
    else if (char === delimiter && depth === 0) {
      parts.push(text.slice(start, index));
      start = index + 1;
    }
  }
  parts.push(text.slice(start));
  return parts;
}

function parseTomlString(raw) {
  if (raw.startsWith("'")) return raw.slice(1, -1);
  try {
    return JSON.parse(raw);
  } catch {
    const body = raw.slice(1, -1);
    return body.replace(/\\(u[0-9a-fA-F]{4}|U[0-9a-fA-F]{8}|[btnfr"\\])/g, (match, token) => {
      if (token.startsWith("u") || token.startsWith("U")) return String.fromCodePoint(parseInt(token.slice(1), 16));
      return { b: "\b", t: "\t", n: "\n", f: "\f", r: "\r", '"': '"', "\\": "\\" }[token];
    });
  }
}

function parseTomlKeyPath(raw) {
  return splitTopLevel(raw.trim(), ".").map((part) => {
    const key = part.trim();
    if (!key) throw new Error("empty TOML key");
    if ((key.startsWith('"') && key.endsWith('"')) || (key.startsWith("'") && key.endsWith("'"))) return parseTomlString(key);
    if (!/^[A-Za-z0-9_-]+$/.test(key)) throw new Error(`unsupported TOML key: ${key}`);
    return key;
  });
}

function parseTomlValue(raw) {
  const value = raw.trim();
  if ((value.startsWith('"') && value.endsWith('"')) || (value.startsWith("'") && value.endsWith("'"))) return parseTomlString(value);
  if (value === "true") return true;
  if (value === "false") return false;
  if (value.startsWith("[") && value.endsWith("]")) {
    const body = value.slice(1, -1).trim();
    return body ? splitTopLevel(body, ",").filter((item) => item.trim()).map(parseTomlValue) : [];
  }
  if (value.startsWith("{") && value.endsWith("}")) {
    const result = {};
    const body = value.slice(1, -1).trim();
    if (!body) return result;
    for (const item of splitTopLevel(body, ",")) {
      const equals = topLevelIndex(item, "=");
      if (equals < 0) throw new Error(`invalid TOML inline table: ${item}`);
      setTomlPath(result, parseTomlKeyPath(item.slice(0, equals)), parseTomlValue(item.slice(equals + 1)));
    }
    return result;
  }
  const numberValue = value.replaceAll("_", "");
  if (/^[+-]?(?:0|[1-9][0-9]*)$/.test(numberValue)) return Number(numberValue);
  if (/^[+-]?(?:[0-9]+\.[0-9]*|[0-9]+(?:\.[0-9]*)?[eE][+-]?[0-9]+)$/.test(numberValue)) {
    const parsed = Number(numberValue);
    if (Number.isFinite(parsed)) return parsed;
  }
  if (/^[+-]?0x[0-9A-Fa-f]+$/.test(numberValue)) return Number.parseInt(numberValue, 16);
  if (/^[+-]?0o[0-7]+$/.test(numberValue)) return Number.parseInt(numberValue, 8);
  if (/^[+-]?0b[01]+$/.test(numberValue)) return Number.parseInt(numberValue, 2);
  if (/^\d{4}-\d{2}-\d{2}(?:T|\s)/.test(value)) return value;
  throw new Error(`unsupported TOML value: ${value}`);
}

function setTomlPath(target, keys, value) {
  let current = target;
  for (let index = 0; index < keys.length - 1; index += 1) {
    const key = keys[index];
    if (!isPlainObject(current[key])) current[key] = {};
    current = current[key];
  }
  current[keys[keys.length - 1]] = value;
}

function parseToml(text, file) {
  const result = {};
  let table = [];
  try {
    for (const rawLine of text.split(/\r?\n/)) {
      const line = stripTomlComment(rawLine).trim();
      if (!line) continue;
      if (line.startsWith("[[")) throw new Error(`unsupported TOML array table: ${line}`);
      if (line.startsWith("[")) {
        if (!line.endsWith("]")) throw new Error(`invalid TOML table: ${line}`);
        table = parseTomlKeyPath(line.slice(1, -1));
        let current = result;
        for (const key of table) {
          if (!isPlainObject(current[key])) current[key] = {};
          current = current[key];
        }
        continue;
      }
      const equals = topLevelIndex(line, "=");
      if (equals < 0) throw new Error(`invalid TOML assignment: ${line}`);
      setTomlPath(result, [...table, ...parseTomlKeyPath(line.slice(0, equals))], parseTomlValue(line.slice(equals + 1)));
    }
  } catch (error) {
    throw new RuntimeError(`invalid TOML in ${file}: ${error.message}`);
  }
  return result;
}

function loadTomlObject(file, allowMissing = false) {
  if (allowMissing && !pathExists(file)) return {};
  let text;
  try {
    text = readText(file);
  } catch (error) {
    if (error.code === "ENOENT") throw new RuntimeError(`missing TOML file: ${file}`);
    throw error;
  }
  const value = parseToml(text, file);
  if (!isPlainObject(value)) throw new RuntimeError(`expected a TOML table in ${file}`);
  return value;
}

function tomlKey(key) {
  return /^[A-Za-z0-9_-]+$/.test(key) ? key : JSON.stringify(key);
}

function tomlPathIdentity(parts) {
  return JSON.stringify(parts);
}

function tomlValue(value) {
  if (typeof value === "string") return JSON.stringify(value);
  if (typeof value === "boolean") return value ? "true" : "false";
  if (typeof value === "number") {
    if (Number.isNaN(value)) return "nan";
    if (value === Infinity) return "inf";
    if (value === -Infinity) return "-inf";
    return String(value);
  }
  if (Array.isArray(value)) return `[${value.map(tomlValue).join(", ")}]`;
  throw new RuntimeError(`unsupported managed TOML value: ${JSON.stringify(value)}`);
}

function flattenTomlLeaves(value, prefix = []) {
  const leaves = [];
  for (const [key, item] of Object.entries(value)) {
    const next = [...prefix, key];
    if (isPlainObject(item)) leaves.push(...flattenTomlLeaves(item, next));
    else leaves.push([next, item]);
  }
  return leaves;
}

function patchTomlText(currentText, expected) {
  const lines = currentText ? currentText.split(/\r?\n/) : [];
  const tableRe = /^\s*\[(.*)\]\s*(?:#.*)?$/;
  function tableRanges() {
    const starts = [[[], -1]];
    lines.forEach((line, index) => {
      const match = line.match(tableRe);
      if (match && !line.trim().startsWith("[[")) {
        try {
          starts.push([parseTomlKeyPath(match[1]), index]);
        } catch {
          // Leave unsupported table syntax untouched; it still marks a new range.
          starts.push([match[1].split("."), index]);
        }
      }
    });
    const result = new Map();
    starts.forEach(([table, headerIndex], index) => {
      const end = index + 1 < starts.length ? starts[index + 1][1] : lines.length;
      result.set(tomlPathIdentity(table), [headerIndex + 1, end]);
    });
    return result;
  }
  for (const [valuePath, value] of flattenTomlLeaves(expected)) {
    const table = valuePath.slice(0, -1);
    const key = valuePath[valuePath.length - 1];
    const ranges = tableRanges();
    const rendered = `${tomlKey(key)} = ${tomlValue(value)}`;
    const tableKey = tomlPathIdentity(table);
    if (ranges.has(tableKey)) {
      const [start, end] = ranges.get(tableKey);
      let replaced = false;
      for (let index = start; index < end; index += 1) {
        const rawLine = lines[index];
        const line = stripTomlComment(rawLine);
        const equals = topLevelIndex(line, "=");
        if (equals < 0) continue;
        let assignmentPath;
        try {
          assignmentPath = parseTomlKeyPath(line.slice(0, equals));
        } catch {
          continue;
        }
        if (assignmentPath.length === 1 && assignmentPath[0] === key) {
          const indent = rawLine.match(/^\s*/)[0];
          lines[index] = indent + rendered;
          replaced = true;
          break;
        }
      }
      if (replaced) continue;
      let insertAt = end;
      while (insertAt > start && lines[insertAt - 1].trim() === "") insertAt -= 1;
      lines.splice(insertAt, 0, rendered);
    } else {
      if (lines.length && lines[lines.length - 1].trim() !== "") lines.push("");
      lines.push(`[${table.map(tomlKey).join(".")}]`, rendered);
    }
  }
  while (lines.length && lines[lines.length - 1] === "") lines.pop();
  return `${lines.join("\n")}\n`;
}

function containsManaged(current, expected) {
  if (isPlainObject(expected)) {
    return isPlainObject(current) && Object.entries(expected).every(([key, value]) => Object.prototype.hasOwnProperty.call(current, key) && containsManaged(current[key], value));
  }
  return deepEqual(current, expected);
}

function logicalFileBytes(file) {
  try {
    const stat = fs.lstatSync(file);
    if (stat.isFile() && !stat.isSymbolicLink()) return fs.readFileSync(file);
  } catch (error) {
    if (error.code !== "ENOENT") return null;
  }
  return null;
}

function treeDigest(root) {
  if (!isDirectory(root) || isSymlink(root)) return null;
  const digest = crypto.createHash("sha256");
  function walk(directory, relativeRoot) {
    const entries = fs.readdirSync(directory).sort();
    const dirs = [];
    const files = [];
    for (const name of entries) {
      const full = path.join(directory, name);
      const stat = fs.lstatSync(full);
      if (stat.isDirectory() || stat.isSymbolicLink()) dirs.push([name, full]);
      else files.push([name, full]);
    }
    for (const [name, full] of dirs) {
      const relative = path.posix.join(relativeRoot, name);
      digest.update(`D\0${relative}\0`);
      if (isSymlink(full)) digest.update(`L\0${fs.readlinkSync(full)}\0`);
      else walk(full, relative);
    }
    for (const [name, full] of files) {
      const relative = path.posix.join(relativeRoot, name);
      if (isSymlink(full)) digest.update(`L\0${relative}\0${fs.readlinkSync(full)}\0`);
      else {
        digest.update(`F\0${relative}\0`);
        digest.update(fs.readFileSync(full));
        digest.update("\0");
      }
    }
  }
  walk(root, "");
  return digest.digest("hex");
}

function skillNames(repo) {
  return fs.readdirSync(path.join(repo, "skills"), { withFileTypes: true })
    .filter((entry) => entry.isDirectory() && isFile(path.join(repo, "skills", entry.name, "SKILL.md")))
    .map((entry) => entry.name)
    .sort();
}

function surfaceHarness(surface) {
  if (surface === "antigravity-ide" || surface === "antigravity-cli") return "antigravity";
  if (HARNESS_NAMES.includes(surface)) return surface;
  throw new RuntimeError(`unknown skill deployment surface: ${surface}`);
}

function skillTargetMap(repo, names) {
  const targets = new Map();
  for (const name of names) {
    const metadataPath = path.join(repo, "skills", name, "dot-agents.json");
    if (!pathExists(metadataPath)) {
      targets.set(name, new Set(HARNESS_NAMES));
      continue;
    }
    const metadata = loadJsonObject(metadataPath);
    if (metadata.version !== 1) throw new RuntimeError(`unsupported dot-agents metadata version in ${metadataPath}`);
    if (!Array.isArray(metadata.targets) || !metadata.targets.length) throw new RuntimeError(`dot-agents metadata targets must be a non-empty array in ${metadataPath}`);
    targets.set(name, new Set(normalizeHarnesses(metadata.targets)));
  }
  return targets;
}

function syncSkillNames(repo, notes) {
  const available = new Map();
  const skipped = new Map();
  const active = [];
  for (const name of skillNames(repo)) {
    const requirement = SKILL_RUNTIME_REQUIREMENTS.find((item) => item.matches(name));
    if (!requirement) {
      active.push(name);
      continue;
    }
    if (!available.has(requirement.runtime)) available.set(requirement.runtime, commandExists(requirement.executable));
    if (available.get(requirement.runtime)) {
      active.push(name);
      continue;
    }
    if (!skipped.has(requirement.runtime)) skipped.set(requirement.runtime, []);
    skipped.get(requirement.runtime).push(name);
  }
  for (const requirement of SKILL_RUNTIME_REQUIREMENTS) {
    const names = skipped.get(requirement.runtime);
    if (names?.length) {
      notes.push(`SKIP runtime ${requirement.runtime}: '${requirement.executable}' is not installed or not available in PATH; skipped skills: ${names.join(", ")}.`);
    }
  }
  return active;
}

function commandExists(name) {
  for (const directory of (process.env.PATH || "").split(path.delimiter).filter(Boolean)) {
    try {
      fs.accessSync(path.join(directory, name), fs.constants.X_OK);
      return true;
    } catch {
      // Continue searching PATH.
    }
  }
  return false;
}

function antigravityIdeInstalled(home) {
  return isDirectory("/Applications/Antigravity.app") || isDirectory(path.join(home, "Applications", "Antigravity.app"));
}

function readState(cfg) {
  const file = path.join(cfg, "state.json");
  return pathExists(file) ? loadJsonObject(file) : { version: 1, skills: {} };
}

function expectedState(installedSurfaces, names, targets) {
  const skills = {};
  for (const surface of Object.keys(installedSurfaces).sort()) {
    const harness = surfaceHarness(surface);
    skills[surface] = names.filter((name) => targets.get(name).has(harness));
  }
  return { version: 1, skills };
}

function sortJson(value) {
  if (Array.isArray(value)) return value.map(sortJson);
  if (!isPlainObject(value)) return value;
  return Object.fromEntries(Object.keys(value).sort().map((key) => [key, sortJson(value[key])]));
}

function jsonBytes(value) {
  return Buffer.from(`${JSON.stringify(sortJson(value), null, 2)}\n`, "utf8");
}

function plan(repo, home, cfg, options = {}) {
  const actions = [];
  const notes = [];
  const storedHarnesses = options.selectedHarnesses === undefined ? readHarnessSelection(cfg) : null;
  const selectedHarnesses = options.selectedHarnesses === undefined
    ? storedHarnesses
    : normalizeHarnesses(options.selectedHarnesses);
  const selectionFile = harnessSelectionPath(cfg);
  if (options.selectedHarnesses !== undefined) {
    const expectedSelection = harnessSelectionBytes(selectedHarnesses);
    const currentSelection = logicalFileBytes(selectionFile);
    if (!currentSelection || !currentSelection.equals(expectedSelection)) {
      actions.push(new Action("selection", selectionFile, "selected harnesses", { content: expectedSelection }));
    }
  }
  const wantsHarness = (name) => selectedHarnesses === null || selectedHarnesses.includes(name);
  const required = [
    path.join(repo, "preferences", "communication.md"),
    path.join(repo, "preferences", "engineering.md"),
    path.join(repo, "harnesses", "codex", "AGENTS.md"),
    path.join(repo, "harnesses", "codex", "config.toml"),
    path.join(repo, "harnesses", "claude", "CLAUDE.md"),
    path.join(repo, "harnesses", "claude", "settings.json"),
    path.join(repo, "harnesses", "antigravity", "instructions.md"),
    path.join(repo, "harnesses", "antigravity", "settings.json"),
  ];
  const missing = required.filter((file) => !isFile(file));
  if (missing.length) throw new RuntimeError(`canonical source missing:\n  ${missing.join("\n  ")}`);

  const repoPointer = path.join(cfg, "repo");
  const pointerContent = Buffer.from(`${repo}\n`);
  const currentPointer = logicalFileBytes(repoPointer);
  if (!currentPointer || !currentPointer.equals(pointerContent)) actions.push(new Action("write", repoPointer, "dot-agents repository pointer", { content: pointerContent }));
  const launcher = path.join(home, ".local", "bin", "dot-agents");
  const launcherBytes = contentBuffer(launcherContent());
  const currentLauncher = logicalFileBytes(launcher);
  if (!currentLauncher || !currentLauncher.equals(launcherBytes)) actions.push(new Action("write-exec", launcher, "dot-agents command launcher", { content: launcherBytes }));

  const installedSurfaces = {};
  const names = syncSkillNames(repo, notes);
  const targets = skillTargetMap(repo, names);
  for (const name of names) {
    const targetNames = [...targets.get(name)];
    if (targetNames.length < HARNESS_NAMES.length) {
      notes.push(`SKIP target ${name}: deployed only to ${targetNames.join(", ")}; not to ${HARNESS_NAMES.filter((harness) => !targets.get(name).has(harness)).join(", ")}.`);
    }
  }
  const codexAvailable = commandExists("codex");
  if (wantsHarness("codex") && codexAvailable) {
    const codexHome = absolutePath(process.env.CODEX_HOME || path.join(home, ".codex"));
    const agentsOverride = path.join(codexHome, "AGENTS.override.md");
    if (isFile(agentsOverride)) notes.push(`WARN Codex: ${agentsOverride} exists; Codex ignores the generated AGENTS.md while it is present.`);
    const target = path.join(codexHome, "AGENTS.md");
    const content = contentBuffer(generatedCodex(repo));
    const current = logicalFileBytes(target);
    if (!current || !current.equals(content)) actions.push(new Action("write", target, "Codex global instructions", { content }));
    planTomlSettings(actions, path.join(repo, "harnesses", "codex", "config.toml"), path.join(cfg, "overrides", "codex.toml"), path.join(codexHome, "config.toml"), "Codex config");
    installedSurfaces.codex = path.join(home, ".agents", "skills");
  } else if (!wantsHarness("codex")) notes.push("SKIP Codex: not selected.");
  else if (selectedHarnesses !== null) notes.push("WAIT Codex: selected, but 'codex' is not installed or not available in PATH.");
  else notes.push("SKIP Codex: 'codex' is not installed or not available in PATH.");

  const claudeAvailable = commandExists("claude");
  if (wantsHarness("claude") && claudeAvailable) {
    const target = path.join(home, ".claude", "CLAUDE.md");
    const content = contentBuffer(generatedClaude(repo));
    const current = logicalFileBytes(target);
    if (!current || !current.equals(content)) actions.push(new Action("write", target, "Claude Code global instructions", { content }));
    installedSurfaces.claude = path.join(home, ".claude", "skills");
    planJsonSettings(actions, path.join(repo, "harnesses", "claude", "settings.json"), path.join(cfg, "overrides", "claude-settings.json"), path.join(home, ".claude", "settings.json"), "Claude Code settings");
  } else if (!wantsHarness("claude")) notes.push("SKIP Claude Code: not selected.");
  else if (selectedHarnesses !== null) notes.push("WAIT Claude Code: selected, but 'claude' is not installed or not available in PATH.");
  else notes.push("SKIP Claude Code: 'claude' is not installed or not available in PATH.");

  const ide = antigravityIdeInstalled(home);
  const agy = commandExists("agy");
  if (wantsHarness("antigravity") && (ide || agy)) {
    const target = path.join(home, ".gemini", "GEMINI.md");
    const content = contentBuffer(generatedAntigravity(repo));
    const current = logicalFileBytes(target);
    if (!current || !current.equals(content)) actions.push(new Action("write", target, "Google Antigravity global instructions", { content }));
  }
  if (wantsHarness("antigravity") && ide) installedSurfaces["antigravity-ide"] = path.join(home, ".gemini", "config", "skills");
  else if (!wantsHarness("antigravity")) notes.push("SKIP Google Antigravity IDE: not selected.");
  else if (selectedHarnesses !== null) notes.push("WAIT Google Antigravity IDE: selected, but Antigravity.app was not found.");
  else notes.push("SKIP Google Antigravity IDE: Antigravity.app was not found.");
  if (wantsHarness("antigravity") && agy) {
    installedSurfaces["antigravity-cli"] = path.join(home, ".gemini", "antigravity-cli", "skills");
    planJsonSettings(actions, path.join(repo, "harnesses", "antigravity", "settings.json"), path.join(cfg, "overrides", "antigravity-settings.json"), path.join(home, ".gemini", "antigravity-cli", "settings.json"), "Antigravity CLI settings");
  } else if (!wantsHarness("antigravity")) notes.push("SKIP Antigravity CLI: not selected.");
  else if (selectedHarnesses !== null) notes.push("WAIT Antigravity CLI: selected, but 'agy' is not installed or not available in PATH.");
  else notes.push("SKIP Antigravity CLI: 'agy' is not installed or not available in PATH.");

  const previousState = readState(cfg);
  const previousSkills = isPlainObject(previousState.skills) ? previousState.skills : {};
  for (const [surface, root] of Object.entries(installedSurfaces)) {
    const surfaceNames = names.filter((name) => targets.get(name).has(surfaceHarness(surface)));
    for (const name of surfaceNames) {
      const source = path.join(repo, "skills", name);
      const destination = path.join(root, name);
      if (treeDigest(source) !== treeDigest(destination)) actions.push(new Action("copy-tree", destination, `${surface} skill ${name}`, { source }));
    }
    const previouslyManaged = previousSkills[surface];
    if (Array.isArray(previouslyManaged)) {
      for (const oldName of [...new Set(previouslyManaged)].sort()) {
        const destination = path.join(root, oldName);
        if (!surfaceNames.includes(oldName) && pathExists(destination)) actions.push(new Action("remove", destination, `removed ${surface} skill ${oldName}`));
      }
    }
  }
  const statePath = path.join(cfg, "state.json");
  const stateContent = jsonBytes(expectedState(installedSurfaces, names, targets));
  const currentState = logicalFileBytes(statePath);
  if (!currentState || !currentState.equals(stateContent)) actions.push(new Action("state", statePath, "local sync ownership state", { content: stateContent }));
  return [actions, notes];
}

function planTomlSettings(actions, canonicalPath, overridePath, destination, label) {
  const canonical = loadTomlObject(canonicalPath);
  const override = loadTomlObject(overridePath, true);
  const expected = deepMerge(canonical, override);
  let current = {};
  let currentText = "";
  let parseFailed = false;
  if (pathExists(destination)) {
    try {
      currentText = readText(destination);
      current = loadTomlObject(destination);
    } catch {
      current = {};
      parseFailed = true;
    }
  }
  const mergedText = patchTomlText(currentText, expected);
  const drift = parseFailed ? mergedText !== currentText : !containsManaged(current, expected);
  if (isSymlink(destination) || drift) actions.push(new Action("toml-merge", destination, label, { content: contentBuffer(mergedText) }));
}

function planJsonSettings(actions, canonicalPath, overridePath, destination, label) {
  const canonical = loadJsonObject(canonicalPath);
  const override = loadJsonObject(overridePath, true);
  const expected = deepMerge(canonical, override);
  let current = {};
  if (pathExists(destination)) {
    try { current = loadJsonObject(destination); } catch { current = {}; }
  }
  if (isSymlink(destination) || !containsManaged(current, expected)) actions.push(new Action("json-merge", destination, label, { jsonValue: deepMerge(current, expected) }));
}

function actionVerb(action) {
  if (action.kind === "remove") return "REMOVE";
  if (action.kind === "selection") return "UPDATE";
  if (action.kind === "json-merge" || action.kind === "toml-merge") return "MERGE";
  if (action.kind === "copy-tree") return "COPY";
  if (action.kind === "state") return "UPDATE";
  return pathExists(action.destination) ? "REPLACE" : "CREATE";
}

function printPlan(actions, notes) {
  for (const note of notes) console.log(note);
  if (!actions.length) return console.log("Everything is in sync.");
  console.log("\nPending sync:");
  for (const action of actions) console.log(`  - ${actionVerb(action)}: ${action.destination} [${action.label}]`);
}

function ensureDirectory(directory) { fs.mkdirSync(directory, { recursive: true }); }

function backupExisting(destination, backupRoot, manifest) {
  if (!pathExists(destination)) return;
  const relative = destination.replace(/^[/\\]+/, "");
  const backupPath = path.join(backupRoot, relative);
  ensureDirectory(path.dirname(backupPath));
  fs.renameSync(destination, backupPath);
  manifest.push([destination, backupPath]);
}

function atomicWrite(destination, content, executable = false) {
  ensureDirectory(path.dirname(destination));
  let tempName;
  for (let attempt = 0; attempt < 10; attempt += 1) {
    const candidate = path.join(path.dirname(destination), `.${path.basename(destination)}.${process.pid}.${crypto.randomBytes(6).toString("hex")}`);
    try {
      fs.writeFileSync(candidate, contentBuffer(content), { flag: "wx" });
      tempName = candidate;
      break;
    } catch (error) {
      if (error.code !== "EEXIST" || attempt === 9) throw error;
    }
  }
  try {
    if (executable) fs.chmodSync(tempName, 0o755);
    fs.renameSync(tempName, destination);
  } finally {
    if (tempName && pathExists(tempName)) fs.rmSync(tempName, { force: true });
  }
}

function localTimestamp() {
  const now = new Date();
  const pad = (value) => String(value).padStart(2, "0");
  return `${now.getFullYear()}${pad(now.getMonth() + 1)}${pad(now.getDate())}-${pad(now.getHours())}${pad(now.getMinutes())}${pad(now.getSeconds())}`;
}

function apply(actions, home) {
  if (!actions.length) return null;
  const backupRoot = path.join(home, ".dot-agents-backups", `${localTimestamp()}-${process.pid}`);
  const manifest = [];
  for (const action of actions) {
    if (action.kind === "state" || action.kind === "selection") {
      atomicWrite(action.destination, action.content);
      continue;
    }
    backupExisting(action.destination, backupRoot, manifest);
    if (action.kind === "remove") continue;
    if (action.kind === "copy-tree") {
      ensureDirectory(path.dirname(action.destination));
      fs.cpSync(action.source, action.destination, { recursive: true, dereference: true });
    } else if (action.kind === "write" || action.kind === "write-exec") {
      atomicWrite(action.destination, action.content, action.kind === "write-exec");
    } else if (action.kind === "json-merge") {
      atomicWrite(action.destination, jsonBytes(action.jsonValue));
    } else if (action.kind === "toml-merge") {
      atomicWrite(action.destination, action.content);
    } else throw new RuntimeError(`unknown action type: ${action.kind}`);
  }
  if (manifest.length) {
    ensureDirectory(backupRoot);
    fs.writeFileSync(path.join(backupRoot, "manifest.tsv"), manifest.map(([original, backup]) => `${original}\t${backup}\n`).join(""), "utf8");
    return backupRoot;
  }
  if (pathExists(backupRoot)) fs.rmSync(backupRoot, { recursive: true, force: true });
  return null;
}

function readLineSync() {
  const bytes = [];
  const buffer = Buffer.alloc(1);
  while (true) {
    const count = fs.readSync(0, buffer, 0, 1, null);
    if (!count || buffer[0] === 10) break;
    if (buffer[0] !== 13) bytes.push(buffer[0]);
  }
  return Buffer.from(bytes).toString("utf8");
}

function runCheck(repo, home, cfg, options = {}) {
  const [actions, notes] = plan(repo, home, cfg, options);
  printPlan(actions, notes);
  return actions.length ? 1 : 0;
}

function runSync(repo, home, cfg, assumeYes, options = {}) {
  const [actions, notes] = plan(repo, home, cfg, options);
  printPlan(actions, notes);
  if (!actions.length) return 0;
  if (options.dryRun) {
    console.log("\nDry-run complete. No files were modified.");
    return 0;
  }
  if (!assumeYes) {
    if (!process.stdin.isTTY) {
      console.error("ERROR: not a terminal; re-run with --yes to sync without confirmation");
      return 2;
    }
    process.stdout.write("\nType YES to apply these changes: ");
    const answer = readLineSync().trim();
    if (answer !== "YES") {
      console.error("ERROR: aborted (you did not type YES)");
      return 2;
    }
  }
  const backupRoot = apply(actions, home);
  console.log(`\nApplied ${actions.length} sync action(s).`);
  if (backupRoot) console.log(`Backups and rollback manifest: ${backupRoot}`);
  const [remaining, remainingNotes] = plan(repo, home, cfg, options);
  if (remaining.length) {
    console.error("\nERROR: sync did not converge:");
    printPlan(remaining, remainingNotes);
    return 1;
  }
  console.log("Everything is in sync.");
  return 0;
}

function harnessAvailability(home) {
  return {
    codex: commandExists("codex"),
    claude: commandExists("claude"),
    antigravity: antigravityIdeInstalled(home) || commandExists("agy"),
  };
}

function askYesNo(prompt, defaultValue) {
  while (true) {
    process.stdout.write(`${prompt} ${defaultValue ? "[Y/n]" : "[y/N]"} `);
    const answer = readLineSync().trim().toLowerCase();
    if (!answer) return defaultValue;
    if (["y", "yes"].includes(answer)) return true;
    if (["n", "no"].includes(answer)) return false;
    console.log("Please answer y/yes or n/no.");
  }
}

function promptHarnessSelection(home, cfg) {
  if (!process.stdin.isTTY || !process.stdout.isTTY) {
    throw new RuntimeError("interactive setup requires a terminal; use --harness <name> or --all together with --yes");
  }
  const current = readHarnessSelection(cfg);
  const available = harnessAvailability(home);
  console.log("dot-agents setup");
  console.log("This configures dot-agents files for selected harnesses; it does not install the harness software.");
  console.log("Press Enter to accept the default shown for each harness.\n");
  const selected = [];
  for (const name of HARNESS_NAMES) {
    const defaultValue = current === null ? available[name] : current.includes(name);
    const status = available[name] ? "detected" : "not detected";
    if (askYesNo(`Configure ${HARNESS_LABELS[name]} (${status})?`, defaultValue)) selected.push(name);
  }
  return normalizeHarnesses(selected);
}

function runSetup(repo, home, cfg, assumeYes, dryRun, explicitHarnesses) {
  const selectedHarnesses = explicitHarnesses === undefined
    ? promptHarnessSelection(home, cfg)
    : normalizeHarnesses(explicitHarnesses);
  const summary = selectedHarnesses.length
    ? selectedHarnesses.map((name) => HARNESS_LABELS[name]).join(", ")
    : "none";
  if (explicitHarnesses !== undefined) {
    console.log(`dot-agents setup: selected harnesses: ${summary}`);
    console.log("This configures dot-agents files; it does not install the harness software.");
  }
  return runSync(repo, home, cfg, assumeYes, { selectedHarnesses, dryRun });
}

function runUpdate(repo, home, cfg, assumeYes) {
  const status = spawnSync("git", ["-C", repo, "status", "--porcelain"], { encoding: "utf8" });
  if (status.error) {
    console.error(`ERROR: cannot run git: ${status.error.message}`);
    return 2;
  }
  if (status.status !== 0) {
    const detail = (status.stderr || "").trim() || "repository is not a Git worktree";
    console.error(`ERROR: cannot inspect canonical repository: ${detail}`);
    return 2;
  }
  if ((status.stdout || "").trim()) {
    console.error("ERROR: canonical repository has uncommitted changes; commit or stash them before `dot-agents update`.");
    console.error(status.stdout.trimEnd());
    return 2;
  }
  const pull = spawnSync("git", ["-C", repo, "pull", "--ff-only"], { stdio: "inherit" });
  if (pull.error || pull.status !== 0) {
    console.error("ERROR: remote update failed; no sync was applied.");
    return pull.status ?? 2;
  }
  if (!looksLikeRepo(repo)) {
    console.error("ERROR: remote update removed or invalidated the dot-agents repository.");
    return 2;
  }
  const syncArgs = [path.join(repo, "scripts", "dot-agents"), "sync"];
  if (assumeYes) syncArgs.push("--yes");
  const sync = spawnSync(process.execPath, syncArgs, { cwd: repo, stdio: "inherit" });
  return sync.status ?? 2;
}

function absoluteMachinePath(value) {
  const found = [];
  if (isPlainObject(value)) {
    for (const item of Object.values(value)) found.push(...absoluteMachinePath(item));
  } else if (Array.isArray(value)) {
    for (const item of value) found.push(...absoluteMachinePath(item));
  } else if (typeof value === "string" && (value.startsWith("/Users/") || value.startsWith("/home/"))) found.push(value);
  return found;
}

function collectSymlinks(root, relativeRoot = "") {
  const found = [];
  for (const entry of fs.readdirSync(root, { withFileTypes: true })) {
    const full = path.join(root, entry.name);
    const relative = path.posix.join(relativeRoot, entry.name);
    if (isSymlink(full)) found.push(relative);
    else if (entry.isDirectory()) found.push(...collectSymlinks(full, relative));
  }
  return found;
}

function runDoctor(repo, home, cfg) {
  let failures = 0;
  let warnings = 0;
  const section = (title) => console.log(`\n${title}`);
  const ok = (message) => console.log(`  OK    ${message}`);
  const info = (message) => console.log(`  INFO  ${message}`);
  const warn = (message) => { warnings += 1; console.log(`  WARN  ${message}`); };
  const fail = (message) => { failures += 1; console.log(`  FAIL  ${message}`); };

  section("Canonical sources");
  const required = [
    "preferences/communication.md",
    "preferences/engineering.md",
    "harnesses/codex/AGENTS.md",
    "harnesses/codex/config.toml",
    "harnesses/claude/CLAUDE.md",
    "harnesses/claude/settings.json",
    "harnesses/antigravity/instructions.md",
    "harnesses/antigravity/settings.json",
    "scripts/dot-agents",
  ];
  for (const relative of required) {
    if (isFile(path.join(repo, relative))) ok(relative);
    else fail(`${relative} missing`);
  }

  section("Canonical settings");
  try {
    const value = loadTomlObject(path.join(repo, "harnesses", "codex", "config.toml"));
    const paths = absoluteMachinePath(value);
    if (paths.length) warn(`harnesses/codex/config.toml contains machine-specific absolute path(s): ${paths.join(", ")}`);
    else ok("harnesses/codex/config.toml is valid portable TOML");
  } catch (error) {
    fail(error.message);
  }
  for (const relative of ["harnesses/claude/settings.json", "harnesses/antigravity/settings.json"]) {
    try {
      const value = loadJsonObject(path.join(repo, relative));
      const paths = absoluteMachinePath(value);
      if (paths.length) warn(`${relative} contains machine-specific absolute path(s): ${paths.join(", ")}`);
      else ok(`${relative} is valid portable JSON`);
    } catch (error) {
      fail(error.message);
    }
  }

  section("Local overrides");
  const overridePaths = [path.join(cfg, "overrides", "codex.toml"), path.join(cfg, "overrides", "claude-settings.json"), path.join(cfg, "overrides", "antigravity-settings.json")];
  let foundOverride = false;
  for (const file of overridePaths) {
    if (!pathExists(file)) continue;
    foundOverride = true;
    try {
      if (file.endsWith(".toml")) loadTomlObject(file);
      else loadJsonObject(file);
      ok(`${file} is valid ${file.endsWith(".toml") ? "TOML" : "JSON"}`);
    } catch (error) {
      fail(error.message);
    }
  }
  if (!foundOverride) info("no device-local overrides configured");

  section("Harness selection");
  try {
    const selected = readHarnessSelection(cfg);
    if (selected === null) info("no explicit harness selection; sync uses PATH/app detection");
    else if (selected.length) ok(`selected: ${selected.map((name) => HARNESS_LABELS[name]).join(", ")}`);
    else ok("selected: none");
  } catch (error) {
    fail(error.message);
  }

  section("Skills canonical set");
  const names = skillNames(repo);
  const brokenDirs = fs.readdirSync(path.join(repo, "skills"), { withFileTypes: true }).filter((entry) => entry.isDirectory() && !isFile(path.join(repo, "skills", entry.name, "SKILL.md"))).map((entry) => entry.name).sort();
  for (const name of brokenDirs) fail(`skills/${name} is missing SKILL.md`);
  ok(`skills/ has ${names.length} installable skill(s)`);
  try {
    const targets = skillTargetMap(repo, names);
    const restricted = names.filter((name) => targets.get(name).size < HARNESS_NAMES.length).map((name) => `${name} (${[...targets.get(name)].join(", ")})`);
    if (restricted.length) info(`harness-targeted skills: ${restricted.join(", ")}`);
    else ok("all skills target every supported harness");
  } catch (error) {
    fail(error.message);
  }
  const sourceSymlinks = names.flatMap((name) => collectSymlinks(path.join(repo, "skills", name), path.join("skills", name)));
  if (sourceSymlinks.length) warn(`skill source contains symlink(s); materialized copy semantics may differ: ${sourceSymlinks.slice(0, 5).join(", ")}`);

  section("Sync status");
  try {
    const [actions, notes] = plan(repo, home, cfg);
    for (const note of notes) {
      if (note.startsWith("WARN ")) warn(note.slice(5));
      else if (note.startsWith("SKIP ")) info(note.slice(5));
      else if (note.startsWith("WAIT ")) info(note.slice(5));
    }
    if (actions.length) {
      fail(`${actions.length} sync action(s) pending; run \`dot-agents check\` then \`dot-agents sync\``);
      actions.slice(0, 10).forEach((action) => console.log(`        ${actionVerb(action)} ${action.destination} [${action.label}]`));
      if (actions.length > 10) console.log(`        ... and ${actions.length - 10} more`);
    } else ok("all managed outputs are in sync");
  } catch (error) {
    fail(error.message);
  }

  section("Skill lockfile");
  const lockPath = path.join(repo, "skills-lock.json");
  if (!pathExists(lockPath)) info("skills-lock.json is absent");
  else {
    try {
      const data = loadJsonObject(lockPath);
      const entries = data.skills ?? {};
      if (!isPlainObject(entries)) fail("skills-lock.json skills must be an object");
      else {
        const missing = Object.keys(entries).filter((name) => !isFile(path.join(repo, "skills", name, "SKILL.md"))).sort();
        if (missing.length) fail(`lockfile entries without skills/<name>/SKILL.md: ${missing.join(", ")}`);
        else ok(`lockfile manages ${Object.keys(entries).length} external skill(s) under skills/`);
        const managed = new Set(Object.keys(entries));
        const local = names.filter((name) => !managed.has(name));
        if (local.length) info(`local/non-lockfile skills: ${local.join(", ")}`);
      }
    } catch (error) {
      fail(error.message);
    }
  }

  section("Backups");
  const backupRoot = path.join(home, ".dot-agents-backups");
  if (isDirectory(backupRoot)) {
    const count = fs.readdirSync(backupRoot, { withFileTypes: true }).filter((entry) => entry.isDirectory()).length;
    info(`${backupRoot}: ${count} backup batch(es)`);
  } else info(`${backupRoot} does not exist`);

  console.log();
  if (failures) {
    console.log(`${failures} FAIL, ${warnings} WARN.`);
    return 1;
  }
  if (warnings) console.log(`No FAIL; ${warnings} WARN require review.`);
  else console.log("All checks passed.");
  return 0;
}

function printUsage(command = null) {
  if (command === "update") return console.log("usage: dot-agents update [--yes]\n\nFast-forward the remote repository, then sync updated content.");
  if (command === "setup") {
    return console.log("usage: dot-agents setup [--harness NAME ... | --harnesses LIST | --all | --none] [--yes] [--dry-run]\n\nSelect which harnesses dot-agents should manage, then sync them.\n\n  --harness NAME    select one harness; repeat or use a comma-separated list\n  --harnesses LIST  select a comma-separated list\n  --all             select Codex, Claude Code, and Google Antigravity\n  --none            select no harness (only local dot-agents metadata is set)\n  --yes             skip the final confirmation; required for non-interactive use\n  --dry-run         show the plan without modifying files\n\nWithout a selection flag, setup asks about all three harnesses interactively.\nHarness names: codex, claude, antigravity");
  }
  console.log("usage: dot-agents <setup|check|sync|update|doctor> [options]\n\nCheck and explicitly sync dot-agents canonical configuration.\n\n  setup             select harnesses interactively, then sync\n  check             read-only: show pending sync actions\n  sync [--yes]      sync selected/detected harness locations\n  update [--yes]    fast-forward remote repository, then sync updated content\n  doctor            run canonical/source/sync diagnostics");
}

function parseHarnessList(raw) {
  const values = String(raw).split(",").map((value) => value.trim()).filter(Boolean);
  if (!values.length) throw new RuntimeError("--harness expects at least one harness name");
  return normalizeHarnesses(values);
}

function parseArgs(argv) {
  if (!argv.length || argv[0] === "--help" || argv[0] === "-h") return { help: true };
  const command = argv[0];
  if (!["check", "sync", "setup", "update", "doctor"].includes(command)) throw new RuntimeError(`unknown command: ${command}`);
  if (argv.slice(1).some((arg) => arg === "--help" || arg === "-h")) return { command, help: true };
  const extra = argv.slice(1);
  if (command !== "setup") {
    const yes = extra.length > 0 && extra.every((arg) => arg === "--yes");
    if (!yes && argv.length > 1) throw new RuntimeError("unrecognized option; use --help for usage");
    if (yes && !["sync", "update"].includes(command)) throw new RuntimeError(`--yes is not valid for ${command}`);
    return { command, yes };
  }

  let yes = false;
  let dryRun = false;
  let selectionSpecified = false;
  let selectionMode = null;
  let selected = [];
  const addSelection = (raw) => {
    if (selectionMode && selectionMode !== "list") throw new RuntimeError("--all/--none cannot be combined with --harness");
    selectionMode = "list";
    selectionSpecified = true;
    selected = [...selected, ...parseHarnessList(raw)];
  };
  for (let index = 0; index < extra.length; index += 1) {
    const arg = extra[index];
    if (arg === "--yes") yes = true;
    else if (arg === "--dry-run") dryRun = true;
    else if (arg === "--all") {
      if (selectionSpecified) throw new RuntimeError("--all cannot be combined with another harness selection flag");
      selectionMode = "all";
      selectionSpecified = true;
      selected = [...HARNESS_NAMES];
    } else if (arg === "--none") {
      if (selectionSpecified) throw new RuntimeError("--none cannot be combined with another harness selection flag");
      selectionMode = "none";
      selectionSpecified = true;
      selected = [];
    } else if (arg === "--harness" || arg === "--harnesses") {
      if (index + 1 >= extra.length) throw new RuntimeError(`${arg} expects a value`);
      addSelection(extra[++index]);
    } else if (arg.startsWith("--harness=") || arg.startsWith("--harnesses=")) {
      addSelection(arg.slice(arg.indexOf("=") + 1));
    } else {
      throw new RuntimeError(`unrecognized setup option: ${arg}`);
    }
  }
  return { command, yes, dryRun, selectedHarnesses: selectionSpecified ? normalizeHarnesses(selected) : undefined };
}

function main() {
  let args;
  try {
    args = parseArgs(process.argv.slice(2));
  } catch (error) {
    console.error(`ERROR: ${error.message}`);
    printUsage(process.argv[2] === "setup" ? "setup" : null);
    return 2;
  }
  if (args.help) {
    printUsage(args.command ?? null);
    return 0;
  }
  const home = installHome();
  const cfg = configHome(home);
  try {
    const repo = resolveRepo(home, cfg);
    if (args.command === "check") return runCheck(repo, home, cfg);
    if (args.command === "sync") return runSync(repo, home, cfg, args.yes);
    if (args.command === "setup") return runSetup(repo, home, cfg, args.yes, args.dryRun, args.selectedHarnesses);
    if (args.command === "update") return runUpdate(repo, home, cfg, args.yes);
    if (args.command === "doctor") return runDoctor(repo, home, cfg);
  } catch (error) {
    console.error(`ERROR: ${error.message}`);
    return 2;
  }
  return 2;
}

if (require.main === module) process.exitCode = main();
