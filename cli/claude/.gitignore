# Legacy runtime directory for the existing ~/.claude whole-directory symlink.
# Canonical tracked sources now live under harnesses/claude/. Keep only the
# compatibility bridge and settings copy visible until setup migrates the
# installation to per-entry management.

# Ignore everything by default …
/*

# … then re-include the compatibility entries.
!/.gitignore
!/CLAUDE.md
!/skills
!/settings.json

# Never track local-only or sensitive settings.
settings.local.json
.last-cleanup
